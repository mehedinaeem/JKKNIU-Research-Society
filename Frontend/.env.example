# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration (for future backend integration)
VITE_API_URL=http://localhost:8000/api

# Environment
VITE_ENV=production

# Analytics (optional)
VITE_ANALYTICS_ID=

# Feature Flags (optional)
VITE_ENABLE_LOGIN=true
VITE_ENABLE_MEMBERSHIP=true

# Public count-only endpoint for research event registrations
VITE_RESEARCH_EVENT_COUNT_URL=

# Internal event registration form bridge (Google formResponse + entry IDs)
VITE_RESEARCH_EVENT_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLSf2NTC6OS5w8wFOLZMD0T52IGg2GxpVO9r3bHHDE1632Ynmpw/formResponse
VITE_RESEARCH_EVENT_ENTRY_FULL_NAME=entry.1885145925
VITE_RESEARCH_EVENT_ENTRY_EMAIL=entry.787947099
VITE_RESEARCH_EVENT_ENTRY_MOBILE_NUMBER=entry.111236255
VITE_RESEARCH_EVENT_ENTRY_DEPARTMENT=entry.1068123373
VITE_RESEARCH_EVENT_ENTRY_SESSION=entry.2145961679
VITE_RESEARCH_EVENT_ENTRY_STUDENT_ID=entry.1979395834
VITE_RESEARCH_EVENT_ENTRY_PREVIOUSLY_PARTICIPATED=entry.370905792
VITE_RESEARCH_EVENT_ENTRY_PREVIOUS_RESEARCH_EXPERIENCE=entry.1568005229
VITE_RESEARCH_EVENT_ENTRY_RESEARCH_AREA=entry.398865954
